---
interface Props {
  title?: string;
  description?: string;
}

const {
  title = 'Voltianix — Monitoreo Inteligente de Flotas Eléctricas',
  description = 'Plataforma de gestión y monitoreo en tiempo real para flotas de vehículos eléctricos. Visualiza estado operativo, batería, autonomía y ubicación.',
} = Astro.props;
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="utf-8" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" href="/favicon.ico" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    <meta name="generator" content={Astro.generator} />

    <!-- Preconnect to font CDN -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Inter:opsz,wght@14..32,400;14..32,500;14..32,600;14..32,700&display=swap"
      rel="stylesheet"
    />

    <title>{title}</title>
  </head>
  <body class="min-h-screen bg-gray-50 font-sans antialiased">
    <slot />
  </body>
</html>

<style is:global>
  @import "tailwindcss";

  /* ── Design Tokens ── */
  :root {
    --color-primary: #10B981;
    --color-primary-hover: #059669;
    --color-accent: #3B82F6;
    --color-accent-hover: #2563EB;
    --color-warning: #F59E0B;
    --color-danger: #EF4444;
    --color-surface: #FFFFFF;
    --color-bg: #F9FAFB;
    --color-text: #111827;
    --color-text-secondary: #6B7280;
    --color-border: #E5E7EB;
    --font-sans: 'Inter', system-ui, -apple-system, sans-serif;
  }

  * {
    box-sizing: border-box;
  }

  body {
    font-family: var(--font-sans);
    color: var(--color-text);
    background-color: var(--color-bg);
    margin: 0;
    padding: 0;
  }

  /* ── Scrollbar styling ── */
  ::-webkit-scrollbar {
    width: 5px;
  }

  ::-webkit-scrollbar-track {
    background: transparent;
  }

  ::-webkit-scrollbar-thumb {
    background: rgba(0, 0, 0, 0.15);
    border-radius: 10px;
  }

  ::-webkit-scrollbar-thumb:hover {
    background: rgba(0, 0, 0, 0.25);
  }
</style>
