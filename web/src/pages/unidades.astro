---
import DashboardLayout from '../layouts/DashboardLayout.astro';
import Header from '../components/layout/Header';
---

<DashboardLayout title="Unidades — Voltianix">
  <div class="h-screen flex flex-col overflow-hidden">
    <Header currentPage="unidades" client:load />

    <main class="flex-1 relative" style="margin-top: 56px;">
      <div class="w-full h-full flex items-center justify-center bg-gray-50">
        <div class="text-center">
          <svg xmlns="http://www.w3.org/2000/svg" class="w-16 h-16 mx-auto mb-4 text-gray-300" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5">
            <path stroke-linecap="round" stroke-linejoin="round" d="M8 7h12m0 0l-4-4m4 4l-4 4m0 6H4m0 0l4 4m-4-4l4-4" />
          </svg>
          <h2 class="text-lg font-semibold text-gray-400 mb-1">Unidades</h2>
          <p class="text-sm text-gray-400">Listado y gestión de vehículos</p>
        </div>
      </div>
    </main>
  </div>
</DashboardLayout>
