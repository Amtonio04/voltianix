        <path stroke-linecap="round" stroke-linejoin="round" d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z" />
      </svg>
      <h2 class="text-lg font-semibold text-gray-400 mb-1">Login</h2>
      <p class="text-sm text-gray-400">Pantalla de inicio de sesión</p>
    </div>
  </main>
</DashboardLayout>
