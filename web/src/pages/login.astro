---
import DashboardLayout from '../layouts/DashboardLayout.astro';
import LoginForm from '../components/auth/LoginForm';
import GuestOnly from '../components/auth/GuestOnly';
---

<DashboardLayout title="Login — Voltianix">
  <GuestOnly client:load>
    <main class="min-h-screen bg-[#1E1E1E] flex items-center justify-center p-5 font-['Poppins']">
      <div
        class="
          w-full
          max-w-[1400px]
          h-[720px]
          overflow-hidden
          rounded-2xl
          border
          border-[#333333]
          bg-white
          grid
          lg:grid-cols-[1.08fr_1fr]
          shadow-2xl
        "
      >
        {/* Lado Izquierdo: Imagen y Texto */}
        <section class="relative overflow-hidden h-full">
          <img
            src="/67.jpg"
            alt="Van Eléctrica Voltianix"
            class="absolute inset-0 w-full h-full object-cover"
          />

          {/* Filtro oscuro para la imagen */}
          <div class="absolute inset-0 bg-black/40"></div>

          {/* Textos sobre la imagen */}
          <div class="absolute left-10 right-10 bottom-12 text-white">
            <h2 class="max-w-[520px] text-[2.5rem] leading-[1.2] font-semibold mb-4">
              La nueva Generación en Gestión de Movilidad Eléctrica.
            </h2>

            <p class="max-w-[500px] text-[13px] leading-relaxed text-white/90">
              Supervisa tu flota en tiempo real, controla la batería de cada
              unidad y optimiza las operaciones desde una plataforma
              inteligente.
            </p>
          </div>
        </section>

        {/* Lado Derecho: Formulario */}
        <section class="flex items-center justify-center bg-[#F7F8FA] px-10">
          <LoginForm client:load />
        </section>
      </div>
    </main>
  </GuestOnly>
</DashboardLayout>